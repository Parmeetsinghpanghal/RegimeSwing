# Streamlit Cloud Secrets Template
# Copy this to .streamlit/secrets.toml and fill in your values
# DO NOT commit the actual secrets.toml to GitHub!

# Telegram Bot Configuration (for alerts)
TELEGRAM_BOT_TOKEN = "your_bot_token_here"
TELEGRAM_CHAT_ID = "your_chat_id_here"

# Broker Configuration (Zerodha Kite Connect)
[broker]
api_key = "your_kite_api_key"
api_secret = "your_kite_api_secret"
# access_token is auto-generated daily via `python main.py auth`

# Configuration overrides (optional - merges with config.yaml)
[config]
capital = {initial = 500000, max_risk_per_trade = 0.015}
# Add any other config overrides here

# Example: Custom scoring weights
# [config.scoring]
# weights = {trend_alignment = 0.25, momentum = 0.20, volume_surge = 0.15, volatility = 0.15, structure = 0.15, regime_alignment = 0.10}