# Swing Toolkit Environment Variables
# Copy to .env and fill in your values

# ============================================================
# ZERODHA KITE CONNECT (Required for live data & trading)
# Get from: https://developers.kite.trade/
# ============================================================
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# KITE_ACCESS_TOKEN=  # Auto-generated daily via auth command

# ============================================================
# TELEGRAM ALERTS (Optional)
# Create bot via @BotFather, get chat_id from @userinfobot
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# EMAIL ALERTS (Optional)
# ============================================================
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=

# ============================================================
# TWILIO SMS (Optional)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# ============================================================
# WEBHOOK (Optional - for Discord, Slack, custom endpoints)
# ============================================================
WEBHOOK_URL=
WEBHOOK_SECRET=

# ============================================================
# TRUE DATA / FINVASIA (Optional - for real-time intraday)
# ============================================================
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
FINVASIA_USER_ID=
FINVASIA_PASSWORD=