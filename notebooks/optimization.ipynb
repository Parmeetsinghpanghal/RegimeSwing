    "# @title 2ï¸âƒ£ Load Config & Prepare Data\n",
    "import yaml\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "with open('/content/RegimeSwing/config.yaml') as f:\n",
    "    CONFIG = yaml.safe_load(f)\n",
    "\n",
    "from data.fetcher import create_fetcher\n",
    "from indicators.technical import add_all_indicators, ensure_multiindex\n",
    "\n",
    "fetcher = create_fetcher('/content/RegimeSwing/config.yaml')\n",
    "symbols = fetcher.nifty200_symbols[:40]\n",
    "\n",
    "df = fetcher.get_price_data(symbols, period='2000d', interval='1d')\n",
    "df = ensure_multiindex(df)\n",
    "df = add_all_indicators(df, CONFIG)\n",
    "\n",
    "nifty_df = fetcher.get_nifty_index_data(period='2000d', interval='1d')\n",
    "nifty_df = ensure_multiindex(nifty_df)\n",
    "nifty_df = add_all_indicators(nifty_df, CONFIG)\n",
    "\n",
    "print(f\"âœ… Data: {df.index.get_level_values('Symbol').nunique()} symbols\")"
