    "# @title 4ï¸âƒ£ Multi-Strategy Joint Optimization\n",
    "def optimize_all_strategies(n_trials=30):\n",
    "    \"\"\"Optimize all 3 swing strategies jointly.\"\"\"\n",
    "    \n",
    "    def multi_objective(trial):\n",
    "        # Trend Pullback params\n",
    "        tp_adx = trial.suggest_int('tp_adx_min', 15, 35)\n",
    "        tp_rsi_min = trial.suggest_int('tp_rsi_min', 30, 50)\n",
    "        tp_rsi_max = trial.suggest_int('tp_rsi_max', 50, 65)\n",
    "        tp_vol = trial.suggest_float('tp_volume_mult', 1.0, 2.0)\n",
    "        \n",
    # Breakout Volume params\n",
    "        bv_vol = trial.suggest_float('bv_volume_mult', 1.2, 2.5)\n",
    "        bv_consol = trial.suggest_int('bv_consolidation_days', 8, 25)\n",
    "        bv_range = trial.suggest_float('bv_consolidation_range', 0.05, 0.12)\n",
    "        \n",
    # Mean Reversion params\n",
    "        mr_rsi = trial.suggest_int('mr_rsi_max', 20, 35)\n",
    "        mr_adx = trial.suggest_int('mr_adx_max', 15, 30)\n",
    "        \n",
    "        test_config = CONFIG.copy()\n",
    "        test_config['swing']['trend_pullback'].update({\n",
    "            'adx_min': tp_adx, 'rsi_min': tp_rsi_min, 'rsi_max': tp_rsi_max, 'volume_mult': tp_vol\n",
    "        })\n",
    "        test_config['swing']['breakout_volume'].update({\n",
    "            'volume_mult': bv_vol, 'min_consolidation_days': bv_consol, 'max_consolidation_range': bv_range\n",
    "        })\n",
    "        test_config['swing']['mean_reversion_bb'].update({\n",
    "            'rsi_max': mr_rsi, 'adx_max': mr_adx\n",
    "        })\n",
    "        \n",
    "        bt_config = BacktestConfig(\n",
    "            start_date='2021-01-01', end_date='2024-12-31',\n",
    "            initial_capital=500000, max_risk_per_trade=0.015,\n",
    "            walk_forward_train_years=2, walk_forward_test_years=1, walk_forward_step_years=1,\n",
    "            monte_carlo_sims=100,\n",
    "        )\n",
    "        \n",
    "        def strat_func(df, _, regime_info):\n",
    "            return run_all_strategies(df, test_config, regime_info)\n",
    "        \n",
    "        detector = RegimeDetector(test_config)\n",
    "        try:\n",
    "            result = run_backtest(bt_config, fetcher, strat_func,\n",
    "                              fetcher.nifty200_symbols[:25], detector)\n",
    "            expectancy = result.metrics.get('expectancy', 0)\n",
    "            max_dd = result.metrics.get('max_drawdown', 1)\n",
    "            sharpe = result.metrics.get('sharpe', 0)\n",
    "            # Multi-objective: maximize expectancy, sharpe; minimize DD\n",
    "            return expectancy * sharpe * (1 - max_dd)\n",
    "        except:\n",
    "            return -1.0\n",
    "    \n",
    "    study = optuna.create_study(direction='maximize')\n",
    "    study.optimize(multi_objective, n_trials=n_trials, timeout=3600, show_progress_bar=True)\n",
    "    return study\n",
    "\n",
    "print(\"ðŸ” Running multi-strategy optimization...\")\n",
    "study = optimize_all_strategies(n_trials=30)\n",
    "\n",
    "print(f\"\\n=== BEST COMBINED PARAMS (Score: {study.best_value:.4f}) ===\")\n",
    "for param, value in study.best_params.items():\n",
    "    print(f\"  {param}: {value}\")"
   ]
  },
