    "for strat, params in current_params.items():\n",
    "    if isinstance(params, dict) and 'enabled' in params:\n",
    "        status = \"âœ… ENABLED\" if params.get('enabled', True) else \"âŒ DISABLED\"\n",
    "        print(f\"  {strat}: {status}\")\n",
    "        for k, v in params.items():\n",
    "            if k != 'enabled':\n",
    "                print(f\"    {k}: {v}\")\n",
    "    else:\n",
    "        print(f\"  {strat}: {params}\")"
