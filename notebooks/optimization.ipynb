    "# @title 7ï¸âƒ£ Auto-Update config.yaml on GitHub\n",
    "import subprocess\n",
    "import os\n",
    "\n",
    "def update_config_yaml(best_params, regime_params):\n",
    "    \"\"\"Update config.yaml with optimized parameters.\"\"\"\n",
    "    \n",
    "    with open('/content/RegimeSwing/config.yaml') as f:\n",
    "        config = yaml.safe_load(f)\n",
    "    \n",
    "    # Update trend_pullback\n",
    "    if 'trend_pullback' in config['swing']:\n",
    "        for key, value in best_params.items():\n",
    "            if key.startswith('tp_'):\n",
    "                config_key = key[3:]  # remove 'tp_'\n",
    "                config['swing']['trend_pullback'][config_key] = value\n",
    "    \n",
    "    # Update breakout_volume\n",
    "    if 'breakout_volume' in config['swing']:\n",
    "        for key, value in best_params.items():\n",
    "            if key.startswith('bv_'):\n",
    "                config_key = key[3:]\n",
    "                config['swing']['breakout_volume'][config_key] = value\n",
    "    \n",
    "    # Update mean_reversion_bb\n",
    "    if 'mean_reversion_bb' in config['swing']:\n",
    "        for key, value in best_params.items():\n",
    "            if key.startswith('mr_'):\n",
    "                config_key = key[3:]\n",
    "                config['swing']['mean_reversion_bb'][config_key] = value\n",
    "    \n",
    "    # Add regime-specific section\n",
    "    config['regime_specific'] = regime_params\n",
    "    \n",
    "    # Save\n",
    "    with open('/content/RegimeSwing/config.yaml', 'w') as f:\n",
    "        yaml.dump(config, f, default_flow_style=False)\n",
    "    \n",
    "    print(\"âœ… config.yaml updated\")\n",
