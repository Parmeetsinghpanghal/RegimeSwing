   "source": [
    "# @title 5ï¸âƒ£ ML-Enhanced Exit: LightGBM Hit Probability\n",
    "import lightgbm as lgb\n",
    "from sklearn.model_selection import TimeSeriesSplit\n",
    "from sklearn.metrics import roc_auc_score, precision_recall_curve\n",
    "\n",
    "print(\"ðŸ¤– Training ML exit model...\")\n",
    "\n",
    "# Prepare training data from historical trades\n",
    "def prepare_ml_data(df, signals, forward_bars=10):\n",
    "    \"\"\"Create features for: will price hit target before stop?\"\"\"\n",
    "    features = []\n",
    "    labels = []\n",
    "    \n",
    "    for sig in signals:\n",
    "        idx = sig.index if hasattr(sig, 'index') else 0\n",
    "        if idx + forward_bars >= len(df):\n",
    "            continue\n",
    "            \n",
    "        sym_df = df.xs(sig.symbol, level='Symbol') if isinstance(df.index, pd.MultiIndex) else df\n",
    "        entry_price = sig.entry_price\n",
    "        stop = sig.stop_price\n",
    "        target = sig.targets[0] if sig.targets else entry_price * 1.02\n",
    "        \n",
    "        # Features at entry\n",
    "        row = sym_df.iloc[idx]\n",
    "        feat = {\n",
    "            'rsi': row.get('RSI_14', 50),\n",
    "            'adx': row.get('ADX_14', 20),\n",
    "            'atr_pct': row.get('ATR_14', 0) / row['Close'],\n",
    "            'vol_ratio': row.get('Volume_Ratio', 1),\n",
    "            'dist_to_ema20': abs(row['Close'] - row.get('EMA_20', row['Close'])) / row['Close'],\n",
    "            'dist_to_ema50': abs(row['Close'] - row.get('EMA_50', row['Close'])) / row['Close'],\n",
    "            'bb_position': (row['Close'] - row.get('BBL_20_2.0', 0)) / \n",
    "                           (row.get('BBU_20_2.0', 1) - row.get('BBL_20_2.0', 1))\n",
    "                           if row.get('BBU_20_2.0', 0) > row.get('BBL_20_2.0', 0) else 0.5,\n",
    "            'r_multiple_target': (target - entry_price) / abs(entry_price - stop),\n",
    "            'regime_bull': 1,  # placeholder\n",
    "        }\n",
    "        \n",
    "        # Label: did it hit target before stop?\n",
    "        future_high = sym_df['High'].iloc[idx+1:idx+forward_bars+1].max()\n",
    "        future_low = sym_df['Low'].iloc[idx+1:idx+forward_bars+1].min()\n",
    "        hit_target = future_high >= target\n",
    "        hit_stop = future_low <= stop\n",
    "        \n",
    "        if hit_target and not hit_stop:\n",
    "            label = 1\n",
    "        elif hit_stop and not hit_target:\n",
    "            label = 0\n",
    "        else:\n",
    "            continue  # ambiguous\n",
    "            \n",
    "        features.append(feat)\n",
    "        labels.append(label)\n",
    "    \n",
    "    return pd.DataFrame(features), np.array(labels)\n",
    "\n",
    "# Collect signals from historical data\n",
    "from indicators.regime import RegimeDetector\n",
    "detector = RegimeDetector(CONFIG)\n",
    "regime = detector.detect_nifty_regime(nifty_df)\n",
    "regime_info = {'regime': regime.regime, 'size_mult': detector.get_size_multiplier(regime),\n",
    "             'nifty_trend': regime.nifty_trend, 'should_trade_swing': detector.should_trade_swing}\n",
    "\n",
    "all_signals = run_all_strategies(df, CONFIG, regime_info)\n",
    "print(f\"Collected {len(all_signals)} historical signals\")\n",
    "\n",
    "X, y = prepare_ml_data(df, all_signals)\n",
    "print(f\"Training samples: {len(X)}, Positive rate: {y.mean():.2%}\")\n",
    "\n",
    "if len(X) > 100:\n",
    "    # Time series split\n",
    "    tscv = TimeSeriesSplit(n_splits=5)\n",
    "    aucs = []\n",
    "    \n",
    "    for train_idx, val_idx in tscv.split(X):\n",
    "        X_train, X_val = X.iloc[train_idx], X.iloc[val_idx]\n",
    "        y_train, y_val = y[train_idx], y[val_idx]\n",
    "        \n",
    "        model = lgb.LGBMClassifier(\n",
    "            n_estimators=200, max_depth=5, learning_rate=0.05,\n",
    "            subsample=0.8, colsample_bytree=0.8,\n",
    "            random_state=42, verbosity=-1\n",
    "        )\n",
    "        model.fit(X_train, y_train, eval_set=[(X_val, y_val)],\n",
    "                  callbacks=[lgb.early_stopping(20), lgb.log_evaluation(0)])\n",
    "        \n",
    "        pred = model.predict_proba(X_val)[:, 1]\n",
    "        auc = roc_auc_score(y_val, pred)\n",
    "        aucs.append(auc)\n",
    "    \n",
    "    print(f\"\\nCV AUC: {np.mean(aucs):.3f} Â± {np.std(aucs):.3f}\")\n",
    "    \n",
    "    # Train final model on all data\n",
    "    final_model = lgb.LGBMClassifier(n_estimators=300, max_depth=5, learning_rate=0.05,\n",
    "                                     random_state=42, verbosity=-1)\n",
    "    final_model.fit(X, y)\n",
    "    \n",
    "    # Feature importance\n",
    "    importance = pd.DataFrame({\n",
    "        'feature': X.columns,\n",
    "        'importance': final_model.feature_importances_\n",
    "    }).sort_values('importance', ascending=False)\n",
    "    print(\"\\n=== FEATURE IMPORTANCE ===\")\n",
    "    print(importance.to_string(index=False))\n",
    "    \n",
    "    # Save model\n",
    "    import joblib\n",
    "    joblib.dump(final_model, '/content/drive/MyDrive/RegimeSwing/models/exit_model.pkl')\n",
    "    print(\"âœ… Model saved to Google Drive\")\n",
    "else:\n",
    "    print(\"âš ï¸ Insufficient data for ML training\")"
   ]
