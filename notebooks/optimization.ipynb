   "source": [
    "# @title 3ï¸âƒ£ Optuna Optimization: Trend Pullback Parameters\n",
    "import optuna\n",
    "from indicators.regime import RegimeDetector\n",
    "from strategies.swing import run_all_strategies\n",
    "from backtest.engine import run_backtest, BacktestConfig\n",
    "\n",
    "def objective(trial):\n",
    "    # Parameters to optimize\n",
    "    adx_min = trial.suggest_int('adx_min', 15, 35)\n",
    "    rsi_min = trial.suggest_int('rsi_min', 30, 50)\n",
    "    rsi_max = trial.suggest_int('rsi_max', 50, 65)\n",
    "    volume_mult = trial.suggest_float('volume_mult', 1.0, 2.0)\n",
    "    stop_atr_mult = trial.suggest_float('stop_atr_mult', 1.5, 3.0)\n",
    "    target_r1 = trial.suggest_float('target_r1', 1.0, 2.5)\n",
    "    target_r2 = trial.suggest_float('target_r2', 2.0, 4.0)\n",
    "    trail_atr_mult = trial.suggest_float('trail_atr_mult', 2.0, 4.0)\n",
    "    \n",
    "    # Update config\n",
    "    test_config = CONFIG.copy()\n",
    "    test_config['swing']['trend_pullback'].update({\n",
    "        'adx_min': adx_min,\n",
    "        'rsi_min': rsi_min,\n",
    "        'rsi_max': rsi_max,\n",
    "        'volume_mult': volume_mult,\n",
    "        'stop_atr_mult': stop_atr_mult,\n",
    "        'target_r_mult': [target_r1, target_r2],\n",
    "        'trail_atr_mult': trail_atr_mult,\n",
    "    })\n",
    "    \n",
    "    # Quick backtest (1 year test)\n",
    "    bt_config = BacktestConfig(\n",
    "        start_date='2022-01-01',\n",
    "        end_date='2024-12-31',\n",
    "        initial_capital=500000,\n",
    "        max_risk_per_trade=0.015,\n",
    "        walk_forward_train_years=2,\n",
    "        walk_forward_test_years=1,\n",
    "        walk_forward_step_years=1,\n",
    "        monte_carlo_sims=100,\n",
    "    )\n",
    "    \n",
    "    def strat_func(df, _, regime_info):\n",
    "        from strategies.swing import run_all_strategies\n",
    "        return run_all_strategies(df, test_config, regime_info)\n",
    "    \n",
    "    detector = RegimeDetector(test_config)\n",
    "    try:\n",
    "        result = run_backtest(bt_config, fetcher, strat_func, \n",
    "                          fetcher.nifty200_symbols[:20], detector)\n",
    "        \n",
    "        # Optimize for: Expectancy * (1 - MaxDD)\n",
    "        expectancy = result.metrics.get('expectancy', 0)\n",
    "        max_dd = result.metrics.get('max_drawdown', 1)\n",
    "        score = expectancy * (1 - max_dd)\n",
    "        return score\n",
    "    except Exception as e:\n",
    "        return -1.0\n",
    "\n",
    "print(\"ðŸ” Running Optuna optimization (50 trials)...\")\n",
    "study = optuna.create_study(direction='maximize', sampler=optuna.samplers.TPESampler(seed=42))\n",
    "study.optimize(objective, n_trials=50, timeout=1800, show_progress_bar=True)\n",
    "\n",
    "print(f\"\\n=== BEST PARAMS (Score: {study.best_value:.4f}) ===\")\n",
    "for param, value in study.best_params.items():\n",
    "    print(f\"  {param}: {value}\")"
   ]
  },
